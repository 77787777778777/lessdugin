{
  "lexicon": 1,
  "id": "online.7778777.lessdugin.index.listRecentDiscussion",
  "description": "List posts with recent comments (the Recent Discussion view).",
  "defs": {
    "main": {
      "type": "query",
      "description": "List posts with recent comments (the Recent Discussion view). First pass (M6).",
      "parameters": {
        "type": "params",
        "required": [
          "forum"
        ],
        "properties": {
          "forum": {
            "type": "string",
            "format": "at-uri",
            "description": "at-uri of the forum declaration.",
            "maxLength": 3000
          },
          "limit": {
            "type": "integer",
            "description": "Page size.",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from a previous response.",
            "maxLength": 512
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "items",
            "asOf",
            "indexer"
          ],
          "properties": {
            "items": {
              "type": "array",
              "description": "Posts with their latest comments.",
              "items": {
                "type": "ref",
                "ref": "#discussionItem"
              },
              "maxLength": 50
            },
            "cursor": {
              "type": "string",
              "description": "Cursor for the next page; absent on the last page.",
              "maxLength": 512
            },
            "asOf": {
              "type": "ref",
              "description": "Indexer state.",
              "ref": "online.7778777.lessdugin.index.defs#asOf"
            },
            "indexer": {
              "type": "ref",
              "description": "Responding indexer.",
              "ref": "online.7778777.lessdugin.index.defs#indexerInfo"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotIndexed",
          "description": "This indexer does not serve the forum."
        }
      ]
    },
    "discussionItem": {
      "type": "object",
      "description": "A post and its latest comments.",
      "required": [
        "post"
      ],
      "properties": {
        "post": {
          "type": "ref",
          "description": "The post.",
          "ref": "online.7778777.lessdugin.index.defs#postView"
        },
        "comments": {
          "type": "array",
          "description": "Latest comments.",
          "items": {
            "type": "ref",
            "ref": "online.7778777.lessdugin.index.defs#commentView"
          },
          "maxLength": 3
        }
      }
    }
  }
}
