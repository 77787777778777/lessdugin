{
  "lexicon": 1,
  "id": "online.7778777.lessdugin.index.getActivity",
  "description": "List public activity concerning an actor.",
  "defs": {
    "main": {
      "type": "query",
      "description": "List public activity concerning an actor. Rate-limited per actor. Later phase, Reserved (P2): clients call it only if describeIndexer.features lists it.",
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "did",
            "description": "The actor."
          },
          "since": {
            "type": "string",
            "format": "datetime",
            "description": "Only activity after this time."
          },
          "forums": {
            "type": "array",
            "description": "Only these forums.",
            "items": {
              "type": "string",
              "format": "at-uri",
              "maxLength": 3000
            },
            "maxLength": 25
          },
          "limit": {
            "type": "integer",
            "description": "Page size.",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor from a previous response.",
            "maxLength": 512
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "activity",
            "asOf",
            "indexer"
          ],
          "properties": {
            "activity": {
              "type": "array",
              "description": "Activity items.",
              "items": {
                "type": "ref",
                "ref": "online.7778777.lessdugin.index.defs#activity"
              },
              "maxLength": 100
            },
            "cursor": {
              "type": "string",
              "description": "Cursor for the next page; absent on the last page.",
              "maxLength": 512
            },
            "asOf": {
              "type": "ref",
              "description": "Indexer state.",
              "ref": "online.7778777.lessdugin.index.defs#asOf"
            },
            "indexer": {
              "type": "ref",
              "description": "Responding indexer.",
              "ref": "online.7778777.lessdugin.index.defs#indexerInfo"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotIndexed",
          "description": "This indexer does not serve the forum."
        }
      ]
    }
  }
}
