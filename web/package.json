{
  "name": "@lessdugin/web",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json && biome check . && node scripts/check-no-raw-href.mjs",
    "test": "vitest run",
    "e2e": "vite build && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-/opt/pw-browsers} playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lessdugin/engine": "workspace:*",
    "@tanstack/history": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "dompurify": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "happy-dom": "^20.0.0",
    "jsdom": "^29.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
