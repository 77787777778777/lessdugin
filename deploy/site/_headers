# Cloudflare Pages / Netlify response headers for the hosted SPA (docs/spec/threat-model.md).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; media-src blob:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types lessdugin-md lessdugin-worker dompurify
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/lessdugin-config.json
  Cache-Control: no-cache
/oauth/*
  Cache-Control: no-cache
  Content-Type: application/json
  Access-Control-Allow-Origin: *
