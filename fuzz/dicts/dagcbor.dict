# DAG-CBOR heads, CID prefixes and the field names of commits, MST nodes, blobs and manifests.
tag42_cid_dagcbor="\xd8*X%\x00\x01q\x12 "
tag42_cid_raw="\xd8*X%\x00\x01U\x12 "
cid_dagcbor="\x01q\x12 "
cid_raw="\x01U\x12 "
key_type="e$type"
key_link="e$link"
key_bytes="f$bytes"
key_blob="dblob"
key_ref="cref"
key_mimeType="hmimeType"
key_size="dsize"
key_e="ae"
key_l="al"
key_p="ap"
key_k="ak"
key_v="av"
key_t="at"
key_did="cdid"
key_version="gversion"
key_data="ddata"
key_rev="crev"
key_prev="dprev"
key_sig="csig"
key_roots="eroots"
key_items="eitems"
key_uri="curi"
key_cid="ccid"
key_commit="fcommit"
key_text="dtext"
map0="\xa0"
list0="\x80"
null="\xf6"
true="\xf5"
false="\xf4"
u8="\x18"
u16="\x19"
u32="\x1a"
u64="\x1b"
bytes32="X "
bytes64="X@"
