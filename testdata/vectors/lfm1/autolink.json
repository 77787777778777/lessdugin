{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 1 GFM extended autolinks (sec. 4.1). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line \u00d7N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "www",
      "input": {
        "text": "see www.example.com now\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">see <a href=\"https://www.example.com\" rel=\"nofollow ugc noopener noreferrer\">www.example.com</a> now</p>\n</div>\n",
        "text": "see www.example.com now"
      }
    },
    {
      "name": "http",
      "input": {
        "text": "see http://example.com/path now\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">see <a href=\"http://example.com/path\" rel=\"nofollow ugc noopener noreferrer\">http://example.com/path</a> now</p>\n</div>\n",
        "text": "see http://example.com/path now"
      }
    },
    {
      "name": "https-with-query-fragment",
      "input": {
        "text": "https://example.com/a?b=c&d=e#frag\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/a?b=c&amp;d=e#frag\" rel=\"nofollow ugc noopener noreferrer\">https://example.com/a?b=c&amp;d=e#frag</a></p>\n</div>\n",
        "text": "https://example.com/a?b=c&d=e#frag"
      }
    },
    {
      "name": "uppercase-prefixes",
      "input": {
        "text": "HTTPS://Example.COM/X and WWW.EXAMPLE.ORG\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/X\" rel=\"nofollow ugc noopener noreferrer\">HTTPS://Example.COM/X</a> and <a href=\"https://www.example.org\" rel=\"nofollow ugc noopener noreferrer\">WWW.EXAMPLE.ORG</a></p>\n</div>\n",
        "text": "HTTPS://Example.COM/X and WWW.EXAMPLE.ORG"
      }
    },
    {
      "name": "boundary-chars",
      "input": {
        "text": "*www.a.com* _www.b.com_ ~www.c.com~ (www.d.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><em><a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a></em> <em><a href=\"https://www.b.com\" rel=\"nofollow ugc noopener noreferrer\">www.b.com</a></em> <del><a href=\"https://www.c.com\" rel=\"nofollow ugc noopener noreferrer\">www.c.com</a></del> (<a href=\"https://www.d.com\" rel=\"nofollow ugc noopener noreferrer\">www.d.com</a>)</p>\n</div>\n",
        "text": "www.a.com www.b.com www.c.com (www.d.com)"
      }
    },
    {
      "name": "no-boundary",
      "input": {
        "text": "xwww.a.com ahttp://b.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">xwww.a.com ahttp://b.com</p>\n</div>\n",
        "text": "xwww.a.com ahttp://b.com"
      }
    },
    {
      "name": "start-of-text-event",
      "input": {
        "text": "**bold**www.example.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><strong>bold</strong><a href=\"https://www.example.com\" rel=\"nofollow ugc noopener noreferrer\">www.example.com</a></p>\n</div>\n",
        "text": "boldwww.example.com"
      }
    },
    {
      "name": "trailing-punctuation",
      "input": {
        "text": "www.a.com. www.b.com! www.c.com? www.d.com, www.e.com: www.f.com*\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a>. <a href=\"https://www.b.com\" rel=\"nofollow ugc noopener noreferrer\">www.b.com</a>! <a href=\"https://www.c.com\" rel=\"nofollow ugc noopener noreferrer\">www.c.com</a>? <a href=\"https://www.d.com\" rel=\"nofollow ugc noopener noreferrer\">www.d.com</a>, <a href=\"https://www.e.com\" rel=\"nofollow ugc noopener noreferrer\">www.e.com</a>: <a href=\"https://www.f.com\" rel=\"nofollow ugc noopener noreferrer\">www.f.com</a>*</p>\n</div>\n",
        "text": "www.a.com. www.b.com! www.c.com? www.d.com, www.e.com: www.f.com*"
      }
    },
    {
      "name": "trailing-dots-and-underscores",
      "input": {
        "text": "www.a.com... www.b.com_ www.c.com./x http://d.e.? (www.f.com.)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a>... <a href=\"https://www.b.com\" rel=\"nofollow ugc noopener noreferrer\">www.b.com</a>_ www.c.com./x <a href=\"http://d.e\" rel=\"nofollow ugc noopener noreferrer\">http://d.e</a>.? (<a href=\"https://www.f.com\" rel=\"nofollow ugc noopener noreferrer\">www.f.com</a>.)</p>\n</div>\n",
        "text": "www.a.com... www.b.com_ www.c.com./x http://d.e.? (www.f.com.)"
      }
    },
    {
      "name": "sentence-final-period",
      "input": {
        "text": "Visit www.example.com. Or https://example.org/path.\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">Visit <a href=\"https://www.example.com\" rel=\"nofollow ugc noopener noreferrer\">www.example.com</a>. Or <a href=\"https://example.org/path\" rel=\"nofollow ugc noopener noreferrer\">https://example.org/path</a>.</p>\n</div>\n",
        "text": "Visit www.example.com. Or https://example.org/path."
      }
    },
    {
      "name": "trailing-quotes",
      "input": {
        "text": "\"www.a.com\" 'www.b.com'\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">\"www.a.com\" 'www.b.com'</p>\n</div>\n",
        "text": "\"www.a.com\" 'www.b.com'"
      }
    },
    {
      "name": "entity-suffix",
      "input": {
        "text": "www.a.com/x&amp; www.b.com/y&hellip; www.c.com/z;\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com/x&amp;\" rel=\"nofollow ugc noopener noreferrer\">www.a.com/x&amp;</a> <a href=\"https://www.b.com/y%E2%80%A6\" rel=\"nofollow ugc noopener noreferrer\">www.b.com/y\u2026</a> <a href=\"https://www.c.com/z\" rel=\"nofollow ugc noopener noreferrer\">www.c.com/z</a>;</p>\n</div>\n",
        "text": "www.a.com/x& www.b.com/y\u2026 www.c.com/z;"
      }
    },
    {
      "name": "unbalanced-parens",
      "input": {
        "text": "www.a.com/x(y) www.b.com/x) (www.c.com/x(y))\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com/x(y)\" rel=\"nofollow ugc noopener noreferrer\">www.a.com/x(y)</a> <a href=\"https://www.b.com/x\" rel=\"nofollow ugc noopener noreferrer\">www.b.com/x</a>) (<a href=\"https://www.c.com/x(y)\" rel=\"nofollow ugc noopener noreferrer\">www.c.com/x(y)</a>)</p>\n</div>\n",
        "text": "www.a.com/x(y) www.b.com/x) (www.c.com/x(y))"
      }
    },
    {
      "name": "stops-at-lt",
      "input": {
        "text": "www.a.com/x<y\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com/x\" rel=\"nofollow ugc noopener noreferrer\">www.a.com/x</a>&lt;y</p>\n</div>\n",
        "text": "www.a.com/x<y"
      }
    },
    {
      "name": "underscore-last-two-segments",
      "input": {
        "text": "www.a_b.com www.x.a_b.com www.a_b.c.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">www.a_b.com www.x.a_b.com <a href=\"https://www.a_b.c.com\" rel=\"nofollow ugc noopener noreferrer\">www.a_b.c.com</a></p>\n</div>\n",
        "text": "www.a_b.com www.x.a_b.com www.a_b.c.com"
      }
    },
    {
      "name": "no-period",
      "input": {
        "text": "http://localhost/x https://x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">http://localhost/x https://x</p>\n</div>\n",
        "text": "http://localhost/x https://x"
      }
    },
    {
      "name": "domain-over-253",
      "input": {
        "text": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com x</p>\n</div>\n",
        "text": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com x"
      }
    },
    {
      "name": "domain-exactly-253",
      "input": {
        "text": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com\" rel=\"nofollow ugc noopener noreferrer\">http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com</a> x</p>\n</div>\n",
        "text": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com x"
      }
    },
    {
      "name": "not-inside-link",
      "input": {
        "text": "[www.a.com](https://b.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://b.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com<span class=\"link-host\">b.com</span></a></p>\n</div>\n",
        "text": "www.a.com"
      }
    },
    {
      "name": "not-inside-image-alt",
      "input": {
        "text": "![www.a.com](x.png)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">www.a.com</p>\n</div>\n",
        "text": "www.a.com"
      }
    },
    {
      "name": "not-inside-code",
      "input": {
        "text": "`www.a.com` and\n\n    www.b.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><code>www.a.com</code> and</p>\n<pre><code>www.b.com\n</code></pre>\n</div>\n",
        "text": "www.a.com and www.b.com"
      }
    },
    {
      "name": "not-inside-literal",
      "input": {
        "text": "<x www.a.com>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;x www.a.com&gt;</p>\n</div>\n",
        "text": "<x www.a.com>"
      }
    },
    {
      "name": "email-not-autolinked",
      "input": {
        "text": "mail me at bob@example.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">mail me at bob@example.com</p>\n</div>\n",
        "text": "mail me at bob@example.com"
      }
    },
    {
      "name": "in-heading-and-table",
      "input": {
        "text": "# www.a.com\n\n| www.b.com |\n|---|\n| http://c.com |\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<h1 id=\"md-h-wwwacom\" dir=\"auto\"><a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a></h1>\n<table>\n<thead>\n<tr>\n<th dir=\"auto\"><a href=\"https://www.b.com\" rel=\"nofollow ugc noopener noreferrer\">www.b.com</a></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\"><a href=\"http://c.com\" rel=\"nofollow ugc noopener noreferrer\">http://c.com</a></td>\n</tr>\n</tbody>\n</table>\n</div>\n",
        "toc": [
          {
            "level": 1,
            "id": "md-h-wwwacom",
            "text": "www.a.com"
          }
        ]
      }
    },
    {
      "name": "adjacent-links",
      "input": {
        "text": "www.a.com www.b.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a> <a href=\"https://www.b.com\" rel=\"nofollow ugc noopener noreferrer\">www.b.com</a></p>\n</div>\n",
        "text": "www.a.com www.b.com"
      }
    },
    {
      "name": "multibyte-before",
      "input": {
        "text": "\u00e9 www.a.com \u00fc\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">\u00e9 <a href=\"https://www.a.com\" rel=\"nofollow ugc noopener noreferrer\">www.a.com</a> \u00fc</p>\n</div>\n",
        "text": "\u00e9 www.a.com \u00fc"
      }
    }
  ]
}
