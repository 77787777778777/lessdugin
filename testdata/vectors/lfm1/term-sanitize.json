{
  "behaviour": "lfm/1",
  "kind": "term_sanitize",
  "description": "term_sanitize(text, ctx) vectors (docs/spec/lfm-1.md sec. 9.1). input: {text, ctx: prose|code|name, max? (Name grapheme cap, 0 = none)}; expected.out is the TermText: a string when every run is plain, else [{plain|escaped: text}, ...]. Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "prose-plain",
      "input": {
        "text": "hello",
        "ctx": "prose"
      },
      "expected": {
        "out": "hello"
      }
    },
    {
      "name": "prose-tab-lf",
      "input": {
        "text": "a\tb\nc",
        "ctx": "prose"
      },
      "expected": {
        "out": "a b c"
      }
    },
    {
      "name": "prose-cr",
      "input": {
        "text": "a\rb",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "^M"
          },
          {
            "plain": "b"
          }
        ]
      }
    },
    {
      "name": "prose-nel",
      "input": {
        "text": "a\u0085b",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "\\u{85}"
          },
          {
            "plain": "b"
          }
        ]
      }
    },
    {
      "name": "prose-ls-ps",
      "input": {
        "text": "a\u2028b\u2029c",
        "ctx": "prose"
      },
      "expected": {
        "out": "a b c"
      }
    },
    {
      "name": "prose-other-ws-kept",
      "input": {
        "text": "a\u00a0b\u3000c\u2003d",
        "ctx": "prose"
      },
      "expected": {
        "out": "a\u00a0b\u3000c\u2003d"
      }
    },
    {
      "name": "prose-esc",
      "input": {
        "text": "\u001b[31mred\u001b[0m",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "escaped": "^["
          },
          {
            "plain": "[31mred"
          },
          {
            "escaped": "^["
          },
          {
            "plain": "[0m"
          }
        ]
      }
    },
    {
      "name": "prose-bel-nul",
      "input": {
        "text": "\u0007\u0000",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "escaped": "^G^@"
          }
        ]
      }
    },
    {
      "name": "prose-del",
      "input": {
        "text": "a\u007fb",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "^?"
          },
          {
            "plain": "b"
          }
        ]
      }
    },
    {
      "name": "prose-c1",
      "input": {
        "text": "\u009b2J\u0090",
        "ctx": "prose"
      },
      "expected": {
        "out": [
          {
            "escaped": "\\u{9b}"
          },
          {
            "plain": "2J"
          },
          {
            "escaped": "\\u{90}"
          }
        ]
      }
    },
    {
      "name": "prose-bidi-removed",
      "input": {
        "text": "a\u202eb\u2066c\u061cd",
        "ctx": "prose"
      },
      "expected": {
        "out": "abcd"
      }
    },
    {
      "name": "prose-zero-width-kept",
      "input": {
        "text": "a\u200bb\ufeffc",
        "ctx": "prose"
      },
      "expected": {
        "out": "a\u200bb\ufeffc"
      }
    },
    {
      "name": "prose-badges-kept",
      "input": {
        "text": "ok ✅ ✓",
        "ctx": "prose"
      },
      "expected": {
        "out": "ok ✅ ✓"
      }
    },
    {
      "name": "code-tab-stops",
      "input": {
        "text": "a\tb\tcd\te",
        "ctx": "code"
      },
      "expected": {
        "out": "a   b   cd  e"
      }
    },
    {
      "name": "code-tab-after-wide",
      "input": {
        "text": "日\tx",
        "ctx": "code"
      },
      "expected": {
        "out": "日  x"
      }
    },
    {
      "name": "code-bidi-visible",
      "input": {
        "text": "a\u202eb\u2069",
        "ctx": "code"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "⟨RLO⟩"
          },
          {
            "plain": "b"
          },
          {
            "escaped": "⟨PDI⟩"
          }
        ]
      }
    },
    {
      "name": "code-zero-width-visible",
      "input": {
        "text": "a\u200bb\u200cc\u200dd\u2060e\ufefff",
        "ctx": "code"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "⟨ZWSP⟩"
          },
          {
            "plain": "b"
          },
          {
            "escaped": "⟨ZWNJ⟩"
          },
          {
            "plain": "c"
          },
          {
            "escaped": "⟨ZWJ⟩"
          },
          {
            "plain": "d"
          },
          {
            "escaped": "⟨WJ⟩"
          },
          {
            "plain": "e"
          },
          {
            "escaped": "⟨BOM⟩"
          },
          {
            "plain": "f"
          }
        ]
      }
    },
    {
      "name": "code-cr-nel-ls",
      "input": {
        "text": "a\rb\u0085c\u2028d",
        "ctx": "code"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "^M"
          },
          {
            "plain": "b"
          },
          {
            "escaped": "\\u{85}"
          },
          {
            "plain": "c d"
          }
        ]
      }
    },
    {
      "name": "name-collapse-trim",
      "input": {
        "text": "  a \t b\u3000\u00a0c  ",
        "ctx": "name"
      },
      "expected": {
        "out": "a b c"
      }
    },
    {
      "name": "name-removes-invisibles-and-badges",
      "input": {
        "text": "al\u200bice\u202e ✅⚠☑ x",
        "ctx": "name"
      },
      "expected": {
        "out": "alice x"
      }
    },
    {
      "name": "name-controls-escaped",
      "input": {
        "text": "a\u001bb\u0085c",
        "ctx": "name"
      },
      "expected": {
        "out": [
          {
            "plain": "a"
          },
          {
            "escaped": "^["
          },
          {
            "plain": "b c"
          }
        ]
      }
    },
    {
      "name": "name-grapheme-cap",
      "input": {
        "text": "abcdefgh",
        "ctx": "name",
        "max": 5
      },
      "expected": {
        "out": "abcd…"
      }
    },
    {
      "name": "name-grapheme-cap-exact",
      "input": {
        "text": "abcde",
        "ctx": "name",
        "max": 5
      },
      "expected": {
        "out": "abcde"
      }
    },
    {
      "name": "name-grapheme-cap-clusters",
      "input": {
        "text": "e\u0301e\u0301e\u0301e\u0301",
        "ctx": "name",
        "max": 3
      },
      "expected": {
        "out": "e\u0301e\u0301…"
      }
    }
  ]
}
