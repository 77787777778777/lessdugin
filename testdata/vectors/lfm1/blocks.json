{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Block constructs (sec. 8.1): alerts, tables, task lists, code classes, ol start, lists, quotes. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "alerts-all",
      "input": {
        "text": "> [!NOTE]\n> n\n\n> [!TIP]\n> t\n\n> [!IMPORTANT]\n> i\n\n> [!WARNING]\n> w\n\n> [!CAUTION]\n> c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<div class=\"alert-note\">\n<p dir=\"auto\">n</p>\n</div>\n<div class=\"alert-tip\">\n<p dir=\"auto\">t</p>\n</div>\n<div class=\"alert-important\">\n<p dir=\"auto\">i</p>\n</div>\n<div class=\"alert-warning\">\n<p dir=\"auto\">w</p>\n</div>\n<div class=\"alert-caution\">\n<p dir=\"auto\">c</p>\n</div>\n</div>\n",
        "text": "n t i w c"
      }
    },
    {
      "name": "table-alignment",
      "input": {
        "text": "| l | c | r | n |\n|:--|:-:|--:|---|\n| 1 | 2 | 3 | 4 |\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<table>\n<thead>\n<tr>\n<th class=\"ta-l\" dir=\"auto\">l</th>\n<th class=\"ta-c\" dir=\"auto\">c</th>\n<th class=\"ta-r\" dir=\"auto\">r</th>\n<th dir=\"auto\">n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"ta-l\" dir=\"auto\">1</td>\n<td class=\"ta-c\" dir=\"auto\">2</td>\n<td class=\"ta-r\" dir=\"auto\">3</td>\n<td dir=\"auto\">4</td>\n</tr>\n</tbody>\n</table>\n</div>\n",
        "text": "l c r n 1 2 3 4"
      }
    },
    {
      "name": "table-escaped-pipe",
      "input": {
        "text": "| a \\| b | `c \\| d` |\n|---|---|\n| e | f |\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">a | b</th>\n<th dir=\"auto\"><code>c | d</code></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\">e</td>\n<td dir=\"auto\">f</td>\n</tr>\n</tbody>\n</table>\n</div>\n",
        "text": "a | b c | d e f"
      }
    },
    {
      "name": "table-header-only",
      "input": {
        "text": "| a | b |\n|---|---|\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">a</th>\n<th dir=\"auto\">b</th>\n</tr>\n</thead>\n</table>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "table-ragged-rows",
      "input": {
        "text": "| a | b |\n|---|---|\n| 1 |\n| 1 | 2 | 3 |\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">a</th>\n<th dir=\"auto\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\">1</td>\n<td dir=\"auto\"></td>\n</tr>\n<tr>\n<td dir=\"auto\">1</td>\n<td dir=\"auto\">2</td>\n</tr>\n</tbody>\n</table>\n</div>\n",
        "text": "a b 1 1 2"
      }
    },
    {
      "name": "task-list-loose",
      "input": {
        "text": "- [ ] a\n\n- [x] b\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><p dir=\"auto\"><input type=\"checkbox\" disabled=\"\"> a</p>\n</li>\n<li dir=\"auto\"><p dir=\"auto\"><input type=\"checkbox\" checked=\"\" disabled=\"\"> b</p>\n</li>\n</ul>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "code-language-classes",
      "input": {
        "text": "```Rust\nx\n```\n\n```c#\ny\n```\n\n```  python3 extra\nz\n```\n\n```aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nw\n```\n\n~~~\nplain\n~~~\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code class=\"language-rust\">x\n</code></pre>\n<pre><code>y\n</code></pre>\n<pre><code class=\"language-python3\">z\n</code></pre>\n<pre><code>w\n</code></pre>\n<pre><code>plain\n</code></pre>\n</div>\n",
        "text": "x y z w plain"
      }
    },
    {
      "name": "indented-code",
      "input": {
        "text": "    code <b>\n      more\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code>code &lt;b&gt;\n  more\n</code></pre>\n</div>\n",
        "text": "code <b> more"
      }
    },
    {
      "name": "ol-start",
      "input": {
        "text": "3. three\n4. four\n\n- x\n\n0. zero\n\n- y\n\n1. one\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ol start=\"3\">\n<li dir=\"auto\">three</li>\n<li dir=\"auto\">four</li>\n</ol>\n<ul>\n<li dir=\"auto\">x</li>\n</ul>\n<ol start=\"0\">\n<li dir=\"auto\">zero</li>\n</ol>\n<ul>\n<li dir=\"auto\">y</li>\n</ul>\n<ol>\n<li dir=\"auto\">one</li>\n</ol>\n</div>\n",
        "text": "three four x zero y one"
      }
    },
    {
      "name": "tight-and-loose-lists",
      "input": {
        "text": "- a\n- b\n\n* c\n\n* d\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\">a</li>\n<li dir=\"auto\">b</li>\n</ul>\n<ul>\n<li dir=\"auto\"><p dir=\"auto\">c</p>\n</li>\n<li dir=\"auto\"><p dir=\"auto\">d</p>\n</li>\n</ul>\n</div>\n",
        "text": "a b c d"
      }
    },
    {
      "name": "nested-lists",
      "input": {
        "text": "- a\n  - b\n    1. c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\">a<ul>\n<li dir=\"auto\">b<ol>\n<li dir=\"auto\">c</li>\n</ol>\n</li>\n</ul>\n</li>\n</ul>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "blockquote-nested",
      "input": {
        "text": "> a\n> > b\n> c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">a</p>\n<blockquote>\n<p dir=\"auto\">b\nc</p>\n</blockquote>\n</blockquote>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "list-item-empty",
      "input": {
        "text": "- \n- x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"></li>\n<li dir=\"auto\">x</li>\n</ul>\n</div>\n",
        "text": "x"
      }
    },
    {
      "name": "code-block-empty",
      "input": {
        "text": "```\n```\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code></code></pre>\n</div>\n",
        "text": ""
      }
    },
    {
      "name": "rule-in-list",
      "input": {
        "text": "- a\n\n  ***\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><p dir=\"auto\">a</p>\n<hr>\n</li>\n</ul>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "code-language-ascii-whitespace-only",
      "input": {
        "text": "```a\u00a0b\nx\n```\n\n```c\u3000d e\ny\n```\n\n```f\u2003g\th\nz\n```\n\n```k\tl\nw\n```\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code>x\n</code></pre>\n<pre><code>y\n</code></pre>\n<pre><code>z\n</code></pre>\n<pre><code class=\"language-k\">w\n</code></pre>\n</div>\n",
        "text": "x y z w"
      }
    }
  ]
}
