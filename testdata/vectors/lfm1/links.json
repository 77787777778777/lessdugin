{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 5 URL policy for links (sec. 4.5) through safe_href (sec. 5.1) and the HTML real-host rule (sec. 5.5). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "https",
      "input": {
        "text": "[a](https://example.com/p)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/p\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "http",
      "input": {
        "text": "[a](http://example.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"http://example.com\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "scheme-and-host-lowercased",
      "input": {
        "text": "[a](HTTPS://EXAMPLE.com/Path)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/Path\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "relative-dropped",
      "input": {
        "text": "[a](/path) [b](page.html) [c](../up)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "protocol-relative-dropped",
      "input": {
        "text": "[a](//example.com/x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "javascript-dropped",
      "input": {
        "text": "[a](javascript:alert(1)) [b](JaVaScRiPt:alert(1))\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "data-file-vbscript-dropped",
      "input": {
        "text": "[a](data:text/html,x) [b](file:///etc/passwd) [c](vbscript:x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
