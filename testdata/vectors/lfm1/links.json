{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 5 URL policy for links (sec. 4.5) through safe_href (sec. 5.1) and the HTML real-host rule (sec. 5.5). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "https",
      "input": {
        "text": "[a](https://example.com/p)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/p\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "http",
      "input": {
        "text": "[a](http://example.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"http://example.com\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "scheme-and-host-lowercased",
      "input": {
        "text": "[a](HTTPS://EXAMPLE.com/Path)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/Path\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "relative-dropped",
      "input": {
        "text": "[a](/path) [b](page.html) [c](../up)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "protocol-relative-dropped",
      "input": {
        "text": "[a](//example.com/x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "javascript-dropped",
      "input": {
        "text": "[a](javascript:alert(1)) [b](JaVaScRiPt:alert(1))\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "data-file-vbscript-dropped",
      "input": {
        "text": "[a](data:text/html,x) [b](file:///etc/passwd) [c](vbscript:x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "userinfo-dropped",
      "input": {
        "text": "[a](https://user:pw@example.com) [b](https://user@example.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "backslash-dropped",
      "input": {
        "text": "[a](<https://example.com\\@evil.com>)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "control-and-space-dropped",
      "input": {
        "text": "[a](<https://exa mple.com>) [b](<https://example.com/\u0007>)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "bidi-dropped",
      "input": {
        "text": "[a](https://example.com/\u202ex)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "zero-width-dropped",
      "input": {
        "text": "[a](https://exa\u200bmple.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "non-ascii-host-dropped",
      "input": {
        "text": "[a](https://exämple.com) [b](https://xn--exmple-cua.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a <a href=\"https://xn--exmple-cua.com\" rel=\"nofollow ugc noopener noreferrer\">b</a></p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "path-percent-encoding",
      "input": {
        "text": "[a](https://example.com/ä/ö?q=ü#ß)\n[b](<https://example.com/a b>)\n[c](https://example.com/%41%zz)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/%C3%A4/%C3%B6?q=%C3%BC#%C3%9F\" rel=\"nofollow ugc noopener noreferrer\">a</a>\nb\n<a href=\"https://example.com/%41%zz\" rel=\"nofollow ugc noopener noreferrer\">c</a></p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "port",
      "input": {
        "text": "[a](https://example.com:8443/x) [b](https://example.com:99999/) [c](https://example.com:/)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com:8443/x\" rel=\"nofollow ugc noopener noreferrer\">a</a> b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "ipv6",
      "input": {
        "text": "[a](http://[2001:db8::1]:8080/x) [b](http://[zz]/)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"http://[2001:db8::1]:8080/x\" rel=\"nofollow ugc noopener noreferrer\">a</a> b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "length-3000-accepted",
      "input": {
        "gen": {
          "prefix": "[a](https://example.com/",
          "repeat": "a",
          "times": 2980,
          "suffix": ")\n"
        }
      },
      "expected": {
        "text": "a",
        "anchors": [],
        "html_tail": "\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n"
      }
    },
    {
      "name": "length-3001-dropped",
      "input": {
        "gen": {
          "prefix": "[a](https://example.com/",
          "repeat": "a",
          "times": 2981,
          "suffix": ")\n"
        }
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n</div>\n"
      }
    },
    {
      "name": "mailto",
      "input": {
        "text": "[mail](mailto:Bob@Example.COM?subject=grüße)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"mailto:Bob@Example.COM?subject=gr%C3%BC%C3%9Fe\" rel=\"nofollow ugc noopener noreferrer\">mail</a></p>\n</div>\n",
        "text": "mail"
      }
    },
    {
      "name": "mailto-space-dropped",
      "input": {
        "text": "[mail](<mailto:bob@example.com?subject=hi there>)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">mail</p>\n</div>\n",
        "text": "mail"
      }
    },
    {
      "name": "mailto-empty-or-slash-dropped",
      "input": {
        "text": "[a](mailto:) [b](mailto:/x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "email-autolink",
      "input": {
        "text": "<bob@example.com>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"mailto:bob@example.com\" rel=\"nofollow ugc noopener noreferrer\">bob@example.com</a></p>\n</div>\n",
        "text": "bob@example.com"
      }
    },
    {
      "name": "fragment-anchor",
      "input": {
        "text": "[a](#Section-One) [b](#md-fn-1) [c](#%C3%9Cber)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a data-anchor=\"section-one\">a</a> <a data-anchor=\"md-fn-1\">b</a> <a data-anchor=\"über\">c</a></p>\n</div>\n",
        "text": "a b c",
        "anchors": []
      }
    },
    {
      "name": "fragment-bad-chars-dropped",
      "input": {
        "text": "[a](#a.b) [b](#/x) [c](#) [d](#a%20b) [e](#%FF)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c d e</p>\n</div>\n",
        "text": "a b c d e"
      }
    },
    {
      "name": "fragment-512-boundary",
      "input": {
        "text": "[a](#) [b](#)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a data-anchor=\"\">a</a> b</p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "title-never-rendered",
      "input": {
        "text": "[a](https://example.com \"Title text\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "reference-link",
      "input": {
        "text": "[a][ref]\n\n[ref]: https://example.com/r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/r\" rel=\"nofollow ugc noopener noreferrer\">a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "host-display-mismatch",
      "input": {
        "text": "[google.com](https://evil.com) [https://www.paypal.com/x](https://evil.example/x)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">google.com<span class=\"link-host\">evil.com</span></a> <a href=\"https://evil.example/x\" rel=\"nofollow ugc noopener noreferrer\">https://www.paypal.com/x<span class=\"link-host\">evil.example</span></a></p>\n</div>\n",
        "text": "google.com https://www.paypal.com/x"
      }
    },
    {
      "name": "host-display-match",
      "input": {
        "text": "[example.com](https://www.example.com) [https://Example.com/a](https://example.com/b) [Click here](https://evil.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://www.example.com\" rel=\"nofollow ugc noopener noreferrer\">example.com</a> <a href=\"https://example.com/b\" rel=\"nofollow ugc noopener noreferrer\">https://Example.com/a</a> <a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">Click here</a></p>\n</div>\n",
        "text": "example.com https://Example.com/a Click here"
      }
    },
    {
      "name": "host-display-at-handle",
      "input": {
        "text": "[@bob.bsky.social](https://evil.com) [bob@good.com](mailto:bob@evil.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">@bob.bsky.social<span class=\"link-host\">evil.com</span></a> <a href=\"mailto:bob@evil.com\" rel=\"nofollow ugc noopener noreferrer\">bob@good.com<span class=\"link-host\">evil.com</span></a></p>\n</div>\n",
        "text": "@bob.bsky.social bob@good.com"
      }
    },
    {
      "name": "host-display-with-port-text",
      "input": {
        "text": "[good.com:443/x](https://evil.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">good.com:443/x<span class=\"link-host\">evil.com</span></a></p>\n</div>\n",
        "text": "good.com:443/x"
      }
    },
    {
      "name": "host-display-not-host-like",
      "input": {
        "text": "[not.a host](https://evil.com) [a..b](https://evil.com) [x.y!](https://evil.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">not.a host</a> <a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">a..b</a> <a href=\"https://evil.com\" rel=\"nofollow ugc noopener noreferrer\">x.y!</a></p>\n</div>\n",
        "text": "not.a host a..b x.y!"
      }
    },
    {
      "name": "unknown-scheme-dropped",
      "input": {
        "text": "[a](ftp://example.com) [b](irc://x) [c](tel:123)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a b c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "link-text-keeps-formatting",
      "input": {
        "text": "[**bold** `code`](https://example.com)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com\" rel=\"nofollow ugc noopener noreferrer\"><strong>bold</strong> <code>code</code></a></p>\n</div>\n",
        "text": "bold code"
      }
    }
  ]
}
