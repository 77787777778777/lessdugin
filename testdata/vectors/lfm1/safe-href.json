{
  "behaviour": "lfm/1",
  "kind": "safe_href",
  "description": "safe_href(raw, ctx) vectors (docs/spec/lfm-1.md sec. 5.1-5.2). input: {raw | raw_gen, ctx: markdown|field}; expected.href is the Href as JSON ({type, ...}) or null. Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "https",
      "input": {
        "raw": "https://example.com/a?b#c",
        "ctx": "markdown"
      },
      "expected": {
        "href": {
          "type": "external",
          "url": "https://example.com/a?b#c",
          "host": "example.com"
        }
      }
    },
    {
      "name": "http-uppercase",
      "input": {
        "raw": "HTTP://EXAMPLE.COM",
        "ctx": "markdown"
      },
      "expected": {
        "href": {
          "type": "external",
          "url": "http://example.com",
          "host": "example.com"
        }
      }
    },
    {
      "name": "empty",
      "input": {
        "raw": "",
        "ctx": "markdown"
      },
      "expected": {
        "href": null
      }
    },
    {
      "name": "over-3000",
      "input": {
        "raw_gen": {
          "prefix": "https://e.com/",
          "repeat": "a",
          "times": 2987
        },
        "ctx": "markdown"
      },
      "expected": {
        "href": null
      }
    },
    {
      "name": "exactly-3000",
      "input": {
        "raw_gen": {
          "prefix": "https://e.com/",
          "repeat": "a",
          "times": 2986
