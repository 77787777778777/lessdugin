{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 2 spoiler and details blocks (sec. 4.2), with P and P_x. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "spoiler-basic",
      "input": {
        "text": "> [!spoiler]\n> the butler did it\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">the butler did it</p>\n</details>\n</div>\n",
        "text": "the butler did it",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "spoiler-case-insensitive",
      "input": {
        "text": "> [!SPOILER]\n> x\n\n> [!Spoiler]\n> y\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">x</p>\n</details>\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">y</p>\n</details>\n</div>\n",
        "text": "x y",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "spoiler-trailing-spaces-tab",
      "input": {
        "text": "> [!spoiler] \t\n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">x</p>\n</details>\n</div>\n",
        "text": "x",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "spoiler-rest-not-blank",
      "input": {
        "text": "> [!spoiler] not alone\n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">[!spoiler] not alone\nx</p>\n</blockquote>\n</div>\n",
        "text": "[!spoiler] not alone x",
        "text_x": "[!spoiler] not alone x",
        "excerpt": "[!spoiler] not alone x"
      }
    },
    {
      "name": "spoiler-marker-whole-paragraph",
      "input": {
        "text": "> [!spoiler]\n>\n> para\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">para</p>\n</details>\n</div>\n",
        "text": "para",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "spoiler-hard-break",
      "input": {
        "text": "> [!spoiler]  \n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">x</p>\n</details>\n</div>\n",
        "text": "x",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "spoiler-empty",
      "input": {
        "text": "> [!spoiler]\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n</details>\n</div>\n",
        "text": "",
        "text_x": "",
        "excerpt": ""
      }
    },
    {
      "name": "details-with-summary",
      "input": {
        "text": "> [!details] Click me\n> body text\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">Click me</summary>\n<p dir=\"auto\">body text</p>\n</details>\n</div>\n",
        "text": "Click me body text",
        "text_x": "Click me body text",
        "excerpt": "Click me body text"
      }
    },
    {
      "name": "details-empty-summary",
      "input": {
        "text": "> [!details]\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">Details</summary>\n<p dir=\"auto\">body</p>\n</details>\n</div>\n",
        "text": "body",
        "text_x": "body",
        "excerpt": "body"
      }
    },
    {
      "name": "details-inline-formatted-summary",
      "input": {
        "text": "> [!details] A *fancy* `sum`\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">A <em>fancy</em> <code>sum</code></summary>\n<p dir=\"auto\">body</p>\n</details>\n</div>\n",
        "text": "A fancy sum body",
        "text_x": "A fancy sum body",
        "excerpt": "A fancy sum body"
      }
    },
    {
      "name": "details-no-space-after-marker",
      "input": {
        "text": "> [!details]x\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">[!details]x\nbody</p>\n</blockquote>\n</div>\n",
        "text": "[!details]x body",
        "text_x": "[!details]x body",
        "excerpt": "[!details]x body"
      }
    },
    {
      "name": "details-summary-only",
      "input": {
        "text": "> [!details] Only summary\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">Only summary</summary>\n</details>\n</div>\n",
        "text": "Only summary",
        "text_x": "Only summary",
        "excerpt": "Only summary"
      }
    },
    {
      "name": "details-summary-spans-emphasis-break",
      "input": {
        "text": "> [!details] *a\n> b* c\n> d\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\"><em>a\nb</em> c</summary>\n<p dir=\"auto\">d</p>\n</details>\n</div>\n",
        "text": "a b c d",
        "text_x": "a b c d",
        "excerpt": "a b c d"
      }
    },
    {
      "name": "nested-spoiler-in-details",
      "input": {
        "text": "> [!details] Outer\n> > [!spoiler]\n> > inner\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">Outer</summary>\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">inner</p>\n</details>\n</details>\n</div>\n",
        "text": "Outer inner",
        "text_x": "Outer",
        "excerpt": "Outer"
      }
    },
    {
      "name": "alert-untouched",
      "input": {
        "text": "> [!NOTE]\n> [!spoiler]\n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<div class=\"alert-note\">\n<p dir=\"auto\">[!spoiler]\nx</p>\n</div>\n</div>\n",
        "text": "[!spoiler] x",
        "text_x": "[!spoiler] x",
        "excerpt": "[!spoiler] x"
      }
    },
    {
      "name": "marker-made-link-by-reference",
      "input": {
        "text": "> [!spoiler]\n> x\n\n[!spoiler]: https://example.com\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\"><a href=\"https://example.com\" rel=\"nofollow ugc noopener noreferrer\">!spoiler</a>\nx</p>\n</blockquote>\n</div>\n",
        "text": "!spoiler x",
        "text_x": "!spoiler x",
        "excerpt": "!spoiler x"
      }
    },
    {
      "name": "literal-never-matches",
      "input": {
        "text": "> <b>[!spoiler]</b>\n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">&lt;b&gt;[!spoiler]&lt;/b&gt;\nx</p>\n</blockquote>\n</div>\n",
        "text": "<b>[!spoiler]</b> x",
        "text_x": "<b>[!spoiler]</b> x",
        "excerpt": "<b>[!spoiler]</b> x"
      }
    },
    {
      "name": "marker-not-first-paragraph",
      "input": {
        "text": "> intro\n>\n> [!spoiler]\n> x\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">intro</p>\n<p dir=\"auto\">[!spoiler]\nx</p>\n</blockquote>\n</div>\n",
        "text": "intro [!spoiler] x",
        "text_x": "intro [!spoiler] x",
        "excerpt": "intro [!spoiler] x"
      }
    },
    {
      "name": "leading-spoiler-excerpt",
      "input": {
        "text": "> [!spoiler]\n> secret words\n\nvisible words\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details class=\"spoiler\">\n<summary dir=\"auto\">Spoiler</summary>\n<p dir=\"auto\">secret words</p>\n</details>\n<p dir=\"auto\">visible words</p>\n</div>\n",
        "text": "secret words visible words",
        "text_x": "visible words",
        "excerpt": "visible words"
      }
    },
    {
      "name": "details-summary-trailing-nbsp",
      "input": {
        "text": "> [!details] Sum\u00a0\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<details>\n<summary dir=\"auto\">Sum</summary>\n<p dir=\"auto\">body</p>\n</details>\n</div>\n",
        "text": "Sum body",
        "text_x": "Sum body",
        "excerpt": "Sum body"
      }
    }
  ]
}
