{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 0 (sec. 3): CR/CRLF in every payload kind, coalescing, the 2^20 event cap (exact, over, at a definition start) and dangling footnote references after truncation. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "crlf-in-text",
      "input": {
        "text": "a\r\nb\r\n\r\nc\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a\nb</p>\n<p dir=\"auto\">c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "cr-in-text",
      "input": {
        "text": "a\rb\r\rc\r"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a\nb</p>\n<p dir=\"auto\">c</p>\n</div>\n",
        "text": "a b c"
      }
    },
    {
      "name": "crlf-in-code-block",
      "input": {
        "text": "```\r\nx\r\ny\r\n```\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code>x\ny\n</code></pre>\n</div>\n",
        "text": "x y"
      }
    },
    {
      "name": "cr-in-indented-code",
      "input": {
        "text": "    x\r    y\r"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code>x\n    y\n</code></pre>\n</div>\n",
        "text": "x y"
      }
    },
    {
      "name": "crlf-in-inline-code",
      "input": {
        "text": "`a\r\nb`\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><code>a  b</code></p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "crlf-in-display-math",
      "input": {
        "text": "$$a\r\nb$$\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math display=\"block\"><mi>a</mi><mi>b</mi></math></p>\n</div>\n",
        "html_temml": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><span data-tex=\"block\">a\nb</span></p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "crlf-in-link-title-and-dest",
      "input": {
        "text": "![alt](https://x.example/a \"t1\r\nt2\")\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<figure>\n<a href=\"https://x.example/a\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: alt</a>\n<figcaption dir=\"auto\">t1\nt2</figcaption>\n</figure>\n</div>\n",
        "text": "alt t1 t2"
      }
    },
    {
      "name": "crlf-in-info-string",
      "input": {
        "text": "```rust\r\nfn x() {}\r\n```\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<pre><code class=\"language-rust\">fn x() {}\n</code></pre>\n</div>\n",
        "text": "fn x() {}"
      }
    },
    {
      "name": "crlf-in-inline-html",
      "input": {
        "text": "a <b\r\nc> d\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a &lt;b\nc&gt; d</p>\n</div>\n",
        "text": "a <b c> d"
      }
    },
    {
      "name": "text-coalescing-brackets",
      "input": {
        "text": "a [b] c [!x] d\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a [b] c [!x] d</p>\n</div>\n",
        "text": "a [b] c [!x] d"
      }
    },
    {
      "name": "text-and-literal-not-merged",
      "input": {
        "text": "a<b>c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a&lt;b&gt;c</p>\n</div>\n",
        "text": "a<b>c"
      }
    },
    {
      "name": "nul-replaced",
      "input": {
        "text": "a\u0000b\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a�b</p>\n</div>\n",
        "text": "a�b"
      }
    },
