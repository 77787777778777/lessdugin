{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Plain-text projection P and P_x (sec. 10.1-10.3). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line \u00d7N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "text-code-math",
      "input": {
        "text": "a `b` $c$ $$d$$\n"
      },
      "expected": {
        "text": "a b c d",
        "text_x": "a b c d",
        "word_count": 4
      }
    },
    {
      "name": "links-and-urls",
      "input": {
        "text": "[text](https://url.example) <https://auto.example> www.ext.example\n"
      },
      "expected": {
        "text": "text https://auto.example www.ext.example",
        "text_x": "text https://auto.example www.ext.example",
        "word_count": 3
      }
    },
    {
      "name": "image-alt-and-figure-caption",
      "input": {
        "text": "![alt](https://x.example/i.png)\n\n![falt](https://x.example/i.png \"Cap\")\n"
      },
      "expected": {
        "text": "alt falt Cap",
        "text_x": "alt falt Cap",
        "word_count": 3
      }
    },
    {
      "name": "block-boundaries",
      "input": {
        "text": "# H\n\npara\n\n> q\n\n- a\n- b\n\n```\ncode\n```\n\n***\n\nend\n"
      },
      "expected": {
        "text": "H para q a b code end",
        "text_x": "H para q a b code end",
        "word_count": 7
      }
    },
    {
      "name": "table-cells",
      "input": {
        "text": "| a | b |\n|---|---|\n| c | d |\n"
      },
      "expected": {
        "text": "a b c d",
        "text_x": "a b c d",
        "word_count": 4
      }
    },
    {
      "name": "soft-and-hard-breaks",
      "input": {
        "text": "a\nb  \nc\n"
      },
      "expected": {
        "text": "a b c",
        "text_x": "a b c",
        "word_count": 3
      }
    },
    {
      "name": "footnotes-at-source-position",
      "input": {
        "text": "x[^1] y\n\n[^1]: note\n\nz\n"
      },
      "expected": {
        "text": "x y note z",
        "text_x": "x y note z",
        "word_count": 4
      }
    },
    {
      "name": "task-markers-and-refs-nothing",
      "input": {
        "text": "- [x] task[^1]\n\n[^1]: n\n"
      },
      "expected": {
        "text": "task n",
        "text_x": "task n",
        "word_count": 2
      }
    },
    {
      "name": "raw-html-literal",
      "input": {
        "text": "a <b>c</b> <!-- d -->\n"
      },
      "expected": {
        "text": "a <b>c</b> <!-- d -->",
        "text_x": "a <b>c</b> <!-- d -->",
        "word_count": 5
      }
    },
    {
      "name": "nfc",
      "input": {
        "text": "Cafe\u0301 n\u0303\n"
      },
      "expected": {
        "text": "Caf\u00e9 \u00f1",
        "text_x": "Caf\u00e9 \u00f1",
        "word_count": 2
      }
    },
    {
      "name": "all-25-white-space",
      "input": {
        "text": "a\t\u000b\f\r \u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000b\n"
      },
      "expected": {
        "text": "a b",
        "text_x": "a b",
        "word_count": 2
      }
    },
    {
      "name": "leading-trailing-trimmed",
      "input": {
        "text": "\u3000\u00a0a\u00a0\u3000\n"
      },
      "expected": {
        "text": "a",
        "text_x": "a",
        "word_count": 1
      }
    },
    {
      "name": "astral-plane",
      "input": {
        "text": "\ud835\udd18\ud835\udd2b\ud835\udd26 \ud83d\ude00 x\n"
      },
      "expected": {
        "text": "\ud835\udd18\ud835\udd2b\ud835\udd26 \ud83d\ude00 x",
        "text_x": "\ud835\udd18\ud835\udd2b\ud835\udd26 \ud83d\ude00 x",
        "word_count": 3
      }
    },
    {
      "name": "mention-source-text",
      "input": {
        "text": "[@alice](at://did:plc:abcdefghijklmnopqrstuvwx) hi\n"
      },
      "expected": {
        "text": "@alice hi",
        "text_x": "@alice hi",
        "word_count": 2
      }
    },
    {
      "name": "spoiler-p-vs-px",
      "input": {
        "text": "a\n\n> [!spoiler]\n> hidden\n\nb\n"
      },
      "expected": {
        "text": "a hidden b",
        "text_x": "a b",
        "word_count": 3
      }
    },
    {
      "name": "details-marker-removed",
      "input": {
        "text": "> [!details] Sum\n> body\n"
      },
      "expected": {
        "text": "Sum body",
        "text_x": "Sum body",
        "word_count": 2
      }
    },
    {
      "name": "control-chars-removed",
      "input": {
        "text": "a\u0001b\u007fc\u0085d\n"
      },
      "expected": {
        "text": "abc d",
        "text_x": "abc d",
        "word_count": 2
      }
    },
    {
      "name": "terminal-escapes-removed",
      "input": {
        "text": "hello \u001b]0;pwned\u0007 \u001b[2J \u009b \u202eevil\n"
      },
      "expected": {
        "text": "hello ]0;pwned [2J evil",
        "text_x": "hello ]0;pwned [2J evil",
        "excerpt": "hello ]0;pwned [2J evil",
        "word_count": 4
      }
    },
    {
      "name": "unreferenced-footnote-in-p",
      "input": {
        "text": "x\n\n[^u]: u text\n"
      },
      "expected": {
        "text": "x u text",
        "text_x": "x u text",
        "word_count": 3
      }
    },
    {
      "name": "alert-marker-not-in-p",
      "input": {
        "text": "> [!NOTE]\n> body\n"
      },
      "expected": {
        "text": "body",
        "text_x": "body",
        "word_count": 1
      }
    }
  ]
}
