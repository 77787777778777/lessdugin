    },
    {
      "name": "target-cut-on-char-boundary",
      "input": {
        "quote": {
          "exact": "é"
        },
        "target_gen": {
          "prefix": "",
          "repeat": "y",
          "times": 199999,
          "suffix": "é"
        }
      },
      "expected": {
        "result": {
          "type": "orphaned"
        }
      }
    },
    {
      "name": "cap-1000-occurrences",
      "input": {
        "quote": {
          "exact": "a",
          "suffix": "b"
        },
        "target_gen": {
          "prefix": "",
          "repeat": "a",
          "times": 1500,
          "suffix": "b"
        }
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 0,
          "end": 1
        }
      }
    },
    {
      "name": "pending",
      "input": {
        "quote": {
          "exact": "cat"
        }
      },
      "expected": {
        "result": {
          "type": "pending"
        }
      }
    },
    {
      "name": "empty-target-orphaned",
      "input": {
        "quote": {
          "exact": "cat"
        },
        "target": ""
      },
      "expected": {
        "result": {
          "type": "orphaned"
        }
      }
    },
    {
      "name": "qkey",
      "input": {
        "quote": {
          "exact": " a\n b "
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
