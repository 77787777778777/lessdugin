{
  "behaviour": "lfm/1",
  "kind": "quote",
  "description": "Quote resolution vectors (docs/spec/lfm-1.md sec. 11). input: {quote: {exact, prefix?, suffix?, start?}, target | target_gen (absent = Pending)}; expected: result ({type: anchored, start, end} in code points | orphaned | pending), qkey, first (CLI --quote first occurrence [start, end] or null). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "zero-occurrences",
      "input": {
        "quote": {
          "exact": "dog"
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "orphaned"
        }
      }
    },
    {
      "name": "one-occurrence",
      "input": {
        "quote": {
          "exact": "cat"
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 4,
          "end": 7
        }
      }
    },
    {
      "name": "many-lowest-offset",
      "input": {
        "quote": {
          "exact": "the"
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 0,
          "end": 3
        }
      }
    },
    {
      "name": "prefix-scoring",
      "input": {
        "quote": {
          "exact": "the",
          "prefix": "with "
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 28,
          "end": 31
        }
      }
    },
    {
      "name": "suffix-scoring",
      "input": {
        "quote": {
          "exact": "the",
          "suffix": " mat"
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 15,
          "end": 18
        }
      }
    },
    {
      "name": "prefix-and-suffix",
      "input": {
        "quote": {
          "exact": "at",
          "prefix": "the h",
          "suffix": ""
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 33,
          "end": 35
        }
      }
    },
    {
      "name": "start-tiebreak",
      "input": {
        "quote": {
          "exact": "the",
          "start": 16
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 15,
          "end": 18
        }
      }
    },
    {
      "name": "start-tiebreak-nearest",
      "input": {
        "quote": {
          "exact": "ab",
          "start": 2
        },
        "target": "ab_ab_ab"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 3,
          "end": 5
        }
      }
    },
    {
      "name": "start-tiebreak-equal-distance-lowest",
      "input": {
        "quote": {
          "exact": "ab",
          "start": 2
        },
        "target": "ab__ab"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 0,
          "end": 2
        }
      }
    },
    {
      "name": "score-beats-start",
      "input": {
        "quote": {
          "exact": "the",
          "suffix": " cat",
          "start": 30
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 0,
          "end": 3
        }
      }
    },
    {
      "name": "overlapping",
      "input": {
        "quote": {
          "exact": "aa",
          "suffix": "a!"
        },
        "target": "aaaa!"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 1,
          "end": 3
        }
      }
    },
    {
      "name": "normalisation-exact-trimmed-ws",
      "input": {
        "quote": {
          "exact": "  cat\n sat\u00a0 "
        },
        "target": "the cat sat on the mat with the hat"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 4,
          "end": 11
        }
      }
    },
    {
      "name": "normalisation-nfc",
      "input": {
        "quote": {
          "exact": "Cafe\u0301"
        },
        "target": "a Café b"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 2,
          "end": 6
        }
      }
    },
    {
      "name": "normalisation-controls-removed",
      "input": {
        "quote": {
          "exact": "c\u0007a\u202et s\u001bat"
        },
        "target": "the cat sat on"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 4,
          "end": 11
        },
        "qkey": "cat sat"
      }
    },
    {
      "name": "astral-offsets",
      "input": {
        "quote": {
          "exact": "x"
        },
        "target": "😀😀 x"
      },
      "expected": {
        "result": {
          "type": "anchored",
          "start": 3,
          "end": 4
        }
      }
    },
    {
