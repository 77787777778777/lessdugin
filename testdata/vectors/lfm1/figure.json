{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Pass 3 figures (sec. 4.3). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "figure-external",
      "input": {
        "text": "![alt](https://img.example/a.png \"A caption\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<figure>\n<a href=\"https://img.example/a.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: alt</a>\n<figcaption dir=\"auto\">A caption</figcaption>\n</figure>\n</div>\n",
        "text": "alt A caption",
        "styled": {
          "blocks": [
            {
              "kind": {
                "para": [
                  [
                    {
                      "text": "[image: alt ⟨img.example⟩]",
                      "style": [
                        "PLACEHOLDER"
                      ],
                      "link": {
                        "external": {
                          "url": "https://img.example/a.png",
                          "host": "img.example"
                        }
                      }
                    }
                  ]
                ]
              }
            },
            {
              "kind": {
                "caption": [
                  {
                    "text": "A caption"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "figure-cid",
      "input": {
        "text": "![alt](cid:bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku \"Cap\")\n",
        "media": [
          {
            "blob": {
              "$type": "blob",
              "ref": {
                "$link": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              },
              "mimeType": "image/png",
              "size": 1234
            }
          }
        ]
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<figure>\n<img data-cid=\"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" alt=\"alt\">\n<figcaption dir=\"auto\">Cap</figcaption>\n</figure>\n</div>\n",
        "text": "alt Cap",
        "styled": {
          "blocks": [
            {
              "kind": {
                "media": {
                  "index": 0,
                  "line": [
                    {
                      "text": "[image 1: alt]",
                      "style": [
                        "PLACEHOLDER"
                      ],
                      "link": {
                        "media": 0
                      }
                    }
                  ]
                }
              }
            },
            {
              "kind": {
                "caption": [
                  {
                    "text": "Cap"
                  }
                ]
              }
            }
          ]
        },
        "media_used": [
          0
        ]
      }
    },
    {
      "name": "no-title-not-figure",
      "input": {
        "text": "![alt](https://img.example/a.png)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://img.example/a.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: alt</a></p>\n</div>\n",
        "text": "alt"
      }
    },
    {
      "name": "whitespace-title-not-figure",
      "input": {
        "text": "![alt](https://img.example/a.png \"   \")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://img.example/a.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: alt</a></p>\n</div>\n",
        "text": "alt"
      }
    },
    {
      "name": "extra-text-not-figure",
      "input": {
        "text": "see ![alt](https://img.example/a.png \"t\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">see <a href=\"https://img.example/a.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: alt</a></p>\n</div>\n",
        "text": "see alt"
      }
    },
    {
      "name": "two-images-not-figure",
      "input": {
        "text": "![a](https://x.example/1.png \"t\") ![b](https://x.example/2.png \"u\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://x.example/1.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: a</a> <a href=\"https://x.example/2.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: b</a></p>\n</div>\n",
        "text": "a b"
      }
    },
    {
      "name": "image-in-link-not-figure",
      "input": {
        "text": "[![a](https://x.example/1.png \"t\")](https://y.example)\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://y.example\" rel=\"nofollow ugc noopener noreferrer\">image: a</a></p>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "caption-trimmed-not-markdown",
      "input": {
        "text": "![a](https://x.example/1.png \"  *not em* <b>  \")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<figure>\n<a href=\"https://x.example/1.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: a</a>\n<figcaption dir=\"auto\">*not em* &lt;b&gt;</figcaption>\n</figure>\n</div>\n",
        "text": "a *not em* <b>"
      }
    },
    {
      "name": "figure-alt-only-scheme",
      "input": {
        "text": "![alt text](ftp://x.example/a \"Cap\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<figure>\nalt text\n<figcaption dir=\"auto\">Cap</figcaption>\n</figure>\n</div>\n",
        "text": "alt text Cap"
      }
    },
    {
      "name": "figure-in-list",
      "input": {
        "text": "- ![a](https://x.example/1.png \"Cap\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><a href=\"https://x.example/1.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: a</a></li>\n</ul>\n</div>\n",
        "text": "a"
      }
    }
  ]
}
