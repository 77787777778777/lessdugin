{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Footnote ordinals, ids, back-links and rendering (sec. 4.6, 8.1). render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "ordinal-by-first-reference",
      "input": {
        "text": "b[^b] a[^a]\n\n[^a]: A\n[^b]: B\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">b<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup> a<sup id=\"md-fnref-2-1\"><a data-anchor=\"md-fn-2\">2</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">B</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n<li id=\"md-fn-2\" dir=\"auto\"><p dir=\"auto\">A</p>\n<a data-anchor=\"md-fnref-2-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fnref-2-1",
          "md-fn-1",
          "md-fn-2"
        ],
        "text": "b a A B"
      }
    },
    {
      "name": "multiple-references",
      "input": {
        "text": "x[^n] y[^n] z[^n]\n\n[^n]: N\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup> y<sup id=\"md-fnref-1-2\"><a data-anchor=\"md-fn-1\">1</a></sup> z<sup id=\"md-fnref-1-3\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">N</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a> <a data-anchor=\"md-fnref-1-2\" class=\"fn-back\">↩2</a> <a data-anchor=\"md-fnref-1-3\" class=\"fn-back\">↩3</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fnref-1-2",
          "md-fnref-1-3",
          "md-fn-1"
        ],
        "text": "x y z N"
      }
    },
    {
      "name": "undefined-label-literal",
      "input": {
        "text": "x[^nope]\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x[^nope]</p>\n</div>\n",
        "anchors": [],
        "text": "x[^nope]"
      }
    },
    {
      "name": "duplicate-definitions-first-wins",
      "input": {
        "text": "x[^d]\n\n[^d]: first\n\n[^d]: second\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">first</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fn-1"
        ],
        "text": "x first second"
      }
    },
    {
      "name": "unreferenced-not-rendered-but-in-p",
      "input": {
        "text": "x\n\n[^u]: unreferenced\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x</p>\n</div>\n",
        "anchors": [],
        "text": "x unreferenced"
      }
    },
    {
      "name": "reference-inside-definition",
      "input": {
        "text": "x[^a]\n\n[^a]: see[^b]\n\n[^b]: B\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">see<sup id=\"md-fnref-2-1\"><a data-anchor=\"md-fn-2\">2</a></sup></p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n<li id=\"md-fn-2\" dir=\"auto\"><p dir=\"auto\">B</p>\n<a data-anchor=\"md-fnref-2-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fn-1",
          "md-fnref-2-1",
          "md-fn-2"
        ],
        "text": "x see B"
      }
    },
    {
      "name": "definition-before-body-reference-order",
      "input": {
        "text": "[^a]: A refs[^b]\n\n[^b]: B\n\nx[^a]\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-2-1\"><a data-anchor=\"md-fn-2\">2</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">B</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n<li id=\"md-fn-2\" dir=\"auto\"><p dir=\"auto\">A refs<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<a data-anchor=\"md-fnref-2-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-2-1",
          "md-fn-1",
          "md-fn-2",
          "md-fnref-1-1"
        ],
        "text": "A refs B x"
      }
    },
    {
      "name": "reference-in-link-text-prevents-link",
      "input": {
        "text": "[link[^1]](https://example.com)\n\n[^1]: N\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">[link<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup>](<a href=\"https://example.com\" rel=\"nofollow ugc noopener noreferrer\">https://example.com</a>)</p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">N</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fn-1"
        ],
        "text": "[link](https://example.com) N"
      }
    },
    {
      "name": "case-insensitive-labels",
      "input": {
        "text": "x[^Note] y[^NOTE]\n\n[^note]: n\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup> y<sup id=\"md-fnref-1-2\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">n</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a> <a data-anchor=\"md-fnref-1-2\" class=\"fn-back\">↩2</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fnref-1-2",
          "md-fn-1"
        ],
        "text": "x y n"
      }
    },
    {
      "name": "reference-only-from-unrendered-definition",
      "input": {
        "text": "x\n\n[^u]: u[^v]\n\n[^v]: v\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x</p>\n</div>\n",
        "anchors": [],
        "text": "x u v"
      }
    },
    {
      "name": "self-reference",
      "input": {
        "text": "x[^s]\n\n[^s]: me[^s]\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">me<sup id=\"md-fnref-1-2\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a> <a data-anchor=\"md-fnref-1-2\" class=\"fn-back\">↩2</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fn-1",
          "md-fnref-1-2"
        ],
        "text": "x me"
      }
    },
    {
      "name": "multi-paragraph-definition",
      "input": {
        "text": "x[^m]\n\n[^m]: para one\n\n    para two\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">para one</p>\n<p dir=\"auto\">para two</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "anchors": [
          "md-fnref-1-1",
          "md-fn-1"
        ],
        "text": "x para one para two"
      }
    },
    {
      "name": "footnote-styled",
      "input": {
        "text": "x[^1]\n\n[^1]: note\n"
      },
      "expected": {
