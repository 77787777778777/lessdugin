{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Serialisation (sec. 8.3): escaping, boolean attributes, attribute order, newline placement, dir. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line \u00d7N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "text-escaping",
      "input": {
        "text": "a & b < c > d \" e ' f\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a &amp; b &lt; c &gt; d \" e ' f</p>\n</div>\n",
        "text": "a & b < c > d \" e ' f"
      }
    },
    {
      "name": "nbsp-text-and-attr",
      "input": {
        "text": "a\u00a0b ![x\u00a0y](cid:bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku)\n",
        "media": [
          {
            "blob": {
              "$type": "blob",
              "ref": {
                "$link": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              },
              "mimeType": "image/png",
              "size": 1234
            }
          }
        ]
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a&nbsp;b <img data-cid=\"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" alt=\"x&nbsp;y\"></p>\n</div>\n"
      }
    },
    {
      "name": "attribute-escaping",
      "input": {
        "text": "![a \"q\" <t> & z](cid:bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku)\n",
        "media": [
          {
            "blob": {
              "$type": "blob",
              "ref": {
                "$link": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              },
              "mimeType": "image/png",
              "size": 1234
            }
          }
        ]
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><img data-cid=\"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" alt=\"a &quot;q&quot; &lt;t&gt; &amp; z\"></p>\n</div>\n"
      }
    },
    {
      "name": "media-alt-cr-nul-normalised",
      "input": {
        "text": "![](cid:bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku)\n",
        "media": [
          {
            "blob": {
              "$type": "blob",
              "ref": {
                "$link": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              },
              "mimeType": "image/png",
              "size": 1234
            },
            "alt": "a\r\nb\rc\u0000d"
          }
        ]
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><img data-cid=\"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" alt=\"a\nb\nc\ufffdd\"></p>\n</div>\n"
      }
    },
    {
      "name": "boolean-attributes",
      "input": {
        "text": "- [x] y\n- [ ] n\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><input type=\"checkbox\" checked=\"\" disabled=\"\"> y</li>\n<li dir=\"auto\"><input type=\"checkbox\" disabled=\"\"> n</li>\n</ul>\n</div>\n"
      }
    },
    {
      "name": "attribute-order-img",
      "input": {
        "text": "![a](cid:bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku)\n",
        "media": [
          {
            "blob": {
              "$type": "blob",
              "ref": {
                "$link": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              },
              "mimeType": "image/png",
              "size": 1234
            },
            "aspectRatio": {
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><img data-cid=\"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" alt=\"a\" width=\"4\" height=\"3\"></p>\n</div>\n"
      }
    },
    {
      "name": "newline-placement",
      "input": {
        "text": "# H\n\n> q\n\n- a\n\n| t |\n|---|\n| d |\n\n```\nc\n```\n\n---\n\na  \nb\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<h1 id=\"md-h-h\" dir=\"auto\">H</h1>\n<blockquote>\n<p dir=\"auto\">q</p>\n</blockquote>\n<ul>\n<li dir=\"auto\">a</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">t</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\">d</td>\n</tr>\n</tbody>\n</table>\n<pre><code>c\n</code></pre>\n<hr>\n<p dir=\"auto\">a<br>\nb</p>\n</div>\n"
      }
    },
    {
      "name": "dir-auto-everywhere",
      "input": {
        "text": "p\n\n# h\n\n- li\n\n| th |\n|---|\n| td |\n\n> [!details] s\n> x\n\n![a](https://x.example/i.png \"cap\")\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">p</p>\n<h1 id=\"md-h-h\" dir=\"auto\">h</h1>\n<ul>\n<li dir=\"auto\">li</li>\n</ul>\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">th</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\">td</td>\n</tr>\n</tbody>\n</table>\n<details>\n<summary dir=\"auto\">s</summary>\n<p dir=\"auto\">x</p>\n</details>\n<figure>\n<a href=\"https://x.example/i.png\" class=\"ext-image\" rel=\"nofollow ugc noopener noreferrer\">image: a</a>\n<figcaption dir=\"auto\">cap</figcaption>\n</figure>\n</div>\n"
      }
    },
    {
      "name": "empty-document",
      "input": {
        "text": ""
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n</div>\n",
        "text": "",
        "anchors": [],
        "styled": {
          "blocks": []
        }
      }
    },
    {
      "name": "whitespace-only-document",
      "input": {
        "text": "  \n\t\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n</div>\n",
        "text": ""
      }
    }
  ]
}
