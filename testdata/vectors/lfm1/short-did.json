{
  "behaviour": "lfm/1",
  "kind": "short_did",
  "description": "short_did(did) vectors (docs/spec/lfm-1.md sec. 5.4). expected.out is the placeholder without the leading @. Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "plc",
      "input": {
        "did": "did:plc:abcdefghijklmnopqrstuvwx"
      },
      "expected": {
        "out": "did:plc:abcdefgh\u2026"
      }
    },
    {
      "name": "web-short",
      "input": {
        "did": "did:web:example.com"
      },
      "expected": {
        "out": "did:web:example.com"
      }
    },
    {
      "name": "web-exactly-40",
      "input": {
        "did": "did:web:aaaaaaaaaaaaaaaaaaaaaaaaaaaa.com"
      },
      "expected": {
        "out": "did:web:aaaaaaaaaaaaaaaaaaaaaaaaaaaa.com"
      }
    },
    {
      "name": "web-41",
      "input": {
        "did": "did:web:aaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com"
      },
      "expected": {
        "out": "did:web:aaaaaaaaaaaaaaaaaaaaaaaaaaaaa.c\u2026"
      }
    }
  ]
}
