{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Parser profile (sec. 2): each enabled extension and each disabled one rendering literally. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "tables",
      "input": {
        "text": "| a | b |\n|---|---|\n| 1 | 2 |\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<table>\n<thead>\n<tr>\n<th dir=\"auto\">a</th>\n<th dir=\"auto\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td dir=\"auto\">1</td>\n<td dir=\"auto\">2</td>\n</tr>\n</tbody>\n</table>\n</div>\n",
        "text": "a b 1 2"
      }
    },
    {
      "name": "footnotes",
      "input": {
        "text": "x[^1]\n\n[^1]: note\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">note</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "text": "x note"
      }
    },
    {
      "name": "strikethrough-double",
      "input": {
        "text": "~~gone~~ text"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><del>gone</del> text</p>\n</div>\n",
        "text": "gone text"
      }
    },
    {
      "name": "strikethrough-single-tilde",
      "input": {
        "text": "~gone~ text"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><del>gone</del> text</p>\n</div>\n",
        "text": "gone text"
      }
    },
    {
      "name": "tasklists",
      "input": {
        "text": "- [ ] open\n- [x] done\n- [X] upper\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><input type=\"checkbox\" disabled=\"\"> open</li>\n<li dir=\"auto\"><input type=\"checkbox\" checked=\"\" disabled=\"\"> done</li>\n<li dir=\"auto\"><input type=\"checkbox\" checked=\"\" disabled=\"\"> upper</li>\n</ul>\n</div>\n",
        "text": "open done upper"
      }
    },
    {
      "name": "math-inline-and-display",
      "input": {
        "text": "$a+b$ and\n\n$$c$$\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mi>a</mi><mo>+</mo><mi>b</mi></math> and</p>\n<p dir=\"auto\"><math display=\"block\"><mi>c</mi></math></p>\n</div>\n",
        "text": "a+b and c"
      }
    },
    {
      "name": "alert-note",
      "input": {
        "text": "> [!NOTE]\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<div class=\"alert-note\">\n<p dir=\"auto\">body</p>\n</div>\n</div>\n",
        "text": "body"
      }
    },
    {
      "name": "alert-kinds-case-insensitive",
      "input": {
        "text": "> [!tip]\n> a\n\n> [!Important]\n> b\n\n> [!WARNING]\n> c\n\n> [!caution]\n> d\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<div class=\"alert-tip\">\n<p dir=\"auto\">a</p>\n</div>\n<div class=\"alert-important\">\n<p dir=\"auto\">b</p>\n</div>\n<div class=\"alert-warning\">\n<p dir=\"auto\">c</p>\n</div>\n<div class=\"alert-caution\">\n<p dir=\"auto\">d</p>\n</div>\n</div>\n",
        "text": "a b c d"
      }
    },
    {
      "name": "alert-marker-not-alone",
      "input": {
        "text": "> [!NOTE] inline\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">[!NOTE] inline\nbody</p>\n</blockquote>\n</div>\n",
        "text": "[!NOTE] inline body"
      }
    },
    {
      "name": "alert-unknown-kind",
      "input": {
        "text": "> [!INFO]\n> body\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">[!INFO]\nbody</p>\n</blockquote>\n</div>\n",
        "text": "[!INFO] body"
      }
    },
    {
      "name": "smart-punctuation-off",
      "input": {
        "text": "\"quotes\" 'single' -- --- ...\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">\"quotes\" 'single' -- --- ...</p>\n</div>\n",
        "text": "\"quotes\" 'single' -- --- ..."
      }
    },
    {
      "name": "heading-attributes-off",
      "input": {
        "text": "# Title {#custom .cls}\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<h1 id=\"md-h-title-custom-cls\" dir=\"auto\">Title {#custom .cls}</h1>\n</div>\n",
        "text": "Title {#custom .cls}",
        "anchors": [
          "md-h-title-custom-cls"
        ]
      }
    },
    {
      "name": "yaml-metadata-off",
      "input": {
        "text": "---\ntitle: x\n---\nbody\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<hr>\n<h2 id=\"md-h-title-x\" dir=\"auto\">title: x</h2>\n<p dir=\"auto\">body</p>\n</div>\n",
        "text": "title: x body"
      }
    },
    {
      "name": "plus-metadata-off",
      "input": {
        "text": "+++\ntitle = 1\n+++\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">+++\ntitle = 1\n+++</p>\n</div>\n",
        "text": "+++ title = 1 +++"
      }
    },
    {
      "name": "definition-list-off",
      "input": {
        "text": "term\n: definition\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">term\n: definition</p>\n</div>\n",
        "text": "term : definition"
      }
    },
    {
      "name": "superscript-off",
      "input": {
        "text": "x^sup^ y\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x^sup^ y</p>\n</div>\n",
        "text": "x^sup^ y"
      }
    },
    {
      "name": "intraword-single-tilde-literal",
      "input": {
        "text": "H~2~O\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">H~2~O</p>\n</div>\n",
        "text": "H~2~O"
      }
    },
    {
      "name": "subscript-syntax-is-strikethrough",
      "input": {
        "text": "x ~2~ y\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x <del>2</del> y</p>\n</div>\n",
        "text": "x 2 y"
      }
    },
    {
      "name": "wikilinks-off",
      "input": {
        "text": "[[Page Name]] and [[a|b]]\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">[[Page Name]] and [[a|b]]</p>\n</div>\n",
        "text": "[[Page Name]] and [[a|b]]"
      }
    },
    {
      "name": "old-footnote-syntax-off",
      "input": {
        "text": "x[^a]\n\n[^a]: first line\nlazy continuation\n\n    indented para\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">x<sup id=\"md-fnref-1-1\"><a data-anchor=\"md-fn-1\">1</a></sup></p>\n<section class=\"footnotes\">\n<ol>\n<li id=\"md-fn-1\" dir=\"auto\"><p dir=\"auto\">first line\nlazy continuation</p>\n<p dir=\"auto\">indented para</p>\n<a data-anchor=\"md-fnref-1-1\" class=\"fn-back\">↩</a></li>\n</ol>\n</section>\n</div>\n",
        "text": "x first line lazy continuation indented para"
      }
    },
    {
      "name": "commonmark-autolink",
      "input": {
        "text": "<https://example.com/a?b=1>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><a href=\"https://example.com/a?b=1\" rel=\"nofollow ugc noopener noreferrer\">https://example.com/a?b=1</a></p>\n</div>\n",
        "text": "https://example.com/a?b=1"
      }
    },
    {
      "name": "hard-and-soft-breaks",
      "input": {
        "text": "a  \nb\\\nc\nd\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a<br>\nb<br>\nc\nd</p>\n</div>\n",
        "text": "a b c d"
      }
    },
    {
      "name": "thematic-breaks",
      "input": {
        "text": "a\n\n***\n\n---\n\n___\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a</p>\n<hr>\n<hr>\n<hr>\n</div>\n",
        "text": "a"
      }
    },
    {
      "name": "setext-headings",
      "input": {
        "text": "Title\n=====\n\nSub\n---\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<h1 id=\"md-h-title\" dir=\"auto\">Title</h1>\n<h2 id=\"md-h-sub\" dir=\"auto\">Sub</h2>\n</div>\n",
        "text": "Title Sub",
        "toc": [
          {
            "level": 1,
            "id": "md-h-title",
            "text": "Title"
          },
          {
            "level": 2,
            "id": "md-h-sub",
            "text": "Sub"
          }
        ]
      }
    },
    {
      "name": "emphasis-nesting",
      "input": {
        "text": "***both*** *em **strong** em* _u_ __s__\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><em><strong>both</strong></em> <em>em <strong>strong</strong> em</em> <em>u</em> <strong>s</strong></p>\n</div>\n",
        "text": "both em strong em u s"
      }
    },
    {
      "name": "backslash-escapes",
      "input": {
        "text": "\\*not em\\* \\[x\\](y) \\<b\\>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">*not em* [x](y) &lt;b&gt;</p>\n</div>\n",
        "text": "*not em* [x](y) <b>"
      }
    },
    {
      "name": "entities-decoded",
      "input": {
        "text": "&copy; &amp; &#65; &#x41; &nbsp;x &bogus;\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">© &amp; A A &nbsp;x &amp;bogus;</p>\n</div>\n",
        "text": "© & A A x &bogus;"
      }
    }
  ]
}
