{
  "behaviour": "lfm/1",
  "kind": "render",
  "description": "Raw HTML as literal text (sec. 3 step 2): HTML blocks of every CommonMark type, inline HTML, comments, entities, multi-line inline HTML. render(text, media, profile) vectors (docs/spec/lfm-1.md). input: {text | gen, media?, profile?, encoding_error?}; gen = prefix + repeat*times + suffix. expected holds only the asserted Rendered fields (html, styled, text, excerpt, toc, word_count, read_minutes, links, mentions, media_used, anchors, flags, error) plus derived fields: html_temml (Temml-mode HTML, sec. 7.5), text_x (P_x, sec. 10.3), html_head/html_tail (first/last 400 chars of html), html_rle (html lines, runs of identical lines as 'line ×N'), html_bytes (UTF-8 length of html). Every render vector is also checked against the sec. 13 invariants (allowlist, idempotence, sanitiser equality, terminal escapes). Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "html-block-type1-script",
      "input": {
        "text": "<script>\nalert(1)\n</script>\nafter\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;script&gt;\nalert(1)\n&lt;/script&gt;</p>\n<p dir=\"auto\">after</p>\n</div>\n",
        "text": "<script> alert(1) </script> after"
      }
    },
    {
      "name": "html-block-type1-style",
      "input": {
        "text": "<style>body{color:red}</style>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;style&gt;body{color:red}&lt;/style&gt;</p>\n</div>\n",
        "text": "<style>body{color:red}</style>"
      }
    },
    {
      "name": "html-block-type1-pre-blank-lines",
      "input": {
        "text": "<pre>\na\n\nb\n</pre>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;pre&gt;\na\n\nb\n&lt;/pre&gt;</p>\n</div>\n",
        "text": "<pre> a b </pre>"
      }
    },
    {
      "name": "html-block-type2-comment",
      "input": {
        "text": "<!-- comment\nspanning -->\ntext\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;!-- comment\nspanning --&gt;</p>\n<p dir=\"auto\">text</p>\n</div>\n",
        "text": "<!-- comment spanning --> text"
      }
    },
    {
      "name": "html-block-type3-pi",
      "input": {
        "text": "<?php echo 1; ?>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;?php echo 1; ?&gt;</p>\n</div>\n",
        "text": "<?php echo 1; ?>"
      }
    },
    {
      "name": "html-block-type4-doctype",
      "input": {
        "text": "<!DOCTYPE html>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;!DOCTYPE html&gt;</p>\n</div>\n",
        "text": "<!DOCTYPE html>"
      }
    },
    {
      "name": "html-block-type5-cdata",
      "input": {
        "text": "<![CDATA[\nx < y\n]]>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;![CDATA[\nx &lt; y\n]]&gt;</p>\n</div>\n",
        "text": "<![CDATA[ x < y ]]>"
      }
    },
    {
      "name": "html-block-type6-div",
      "input": {
        "text": "<div onclick=\"x()\">\n*not md*\n</div>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;div onclick=\"x()\"&gt;\n*not md*\n&lt;/div&gt;</p>\n</div>\n",
        "text": "<div onclick=\"x()\"> *not md* </div>"
      }
    },
    {
      "name": "html-block-type7-custom",
      "input": {
        "text": "<my-element attr=\"1\">\n\npara\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;my-element attr=\"1\"&gt;</p>\n<p dir=\"auto\">para</p>\n</div>\n",
        "text": "<my-element attr=\"1\"> para"
      }
    },
    {
      "name": "html-block-in-blockquote",
      "input": {
        "text": "> <div>\n> quoted\n> </div>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<blockquote>\n<p dir=\"auto\">&lt;div&gt;\nquoted\n&lt;/div&gt;</p>\n</blockquote>\n</div>\n",
        "text": "<div> quoted </div>"
      }
    },
    {
      "name": "html-block-in-list",
      "input": {
        "text": "- <details>\n  <summary>x</summary>\n  </details>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<ul>\n<li dir=\"auto\"><p dir=\"auto\">&lt;details&gt;\n&lt;summary&gt;x&lt;/summary&gt;\n&lt;/details&gt;</p>\n</li>\n</ul>\n</div>\n",
        "text": "<details> <summary>x</summary> </details>"
      }
    },
    {
      "name": "inline-html",
      "input": {
        "text": "a <b>bold</b> <img src=x onerror=alert(1)> c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a &lt;b&gt;bold&lt;/b&gt; &lt;img src=x onerror=alert(1)&gt; c</p>\n</div>\n",
        "text": "a <b>bold</b> <img src=x onerror=alert(1)> c"
      }
    },
    {
      "name": "inline-html-multiline",
      "input": {
        "text": "a <span\ntitle=\"x\">b</span> c\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a &lt;span\ntitle=\"x\"&gt;b&lt;/span&gt; c</p>\n</div>\n",
        "text": "a <span title=\"x\">b</span> c"
      }
    },
    {
      "name": "inline-comment",
      "input": {
        "text": "a <!-- hidden --> b\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">a &lt;!-- hidden --&gt; b</p>\n</div>\n",
        "text": "a <!-- hidden --> b"
      }
    },
    {
      "name": "inline-html-adjacent-coalesced",
      "input": {
        "text": "<b><i>x</i></b>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;b&gt;&lt;i&gt;x&lt;/i&gt;&lt;/b&gt;</p>\n</div>\n",
        "text": "<b><i>x</i></b>"
      }
    },
    {
      "name": "entity-in-html-block-kept",
      "input": {
        "text": "<p>&amp; &lt;</p>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;p&gt;&amp;amp; &amp;lt;&lt;/p&gt;</p>\n</div>\n",
        "text": "<p>&amp; &lt;</p>"
      }
    },
    {
      "name": "autolink-in-text-not-in-literal",
      "input": {
        "text": "<a href=\"https://www.example.com\">www.example.com</a>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;a href=\"https://www.example.com\"&gt;<a href=\"https://www.example.com\" rel=\"nofollow ugc noopener noreferrer\">www.example.com</a>&lt;/a&gt;</p>\n</div>\n",
        "text": "<a href=\"https://www.example.com\">www.example.com</a>"
      }
    },
    {
      "name": "html-block-crlf",
      "input": {
        "text": "<div>\r\nline\r\n</div>\r\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;div&gt;\nline\n&lt;/div&gt;</p>\n</div>\n",
        "text": "<div> line </div>"
      }
    },
    {
      "name": "javascript-in-inline-html",
      "input": {
        "text": "click <a href=\"javascript:alert(1)\">me</a>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">click &lt;a href=\"javascript:alert(1)\"&gt;me&lt;/a&gt;</p>\n</div>\n",
        "text": "click <a href=\"javascript:alert(1)\">me</a>"
      }
    },
    {
      "name": "closing-tags-only",
      "input": {
        "text": "</div></p>\n"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;/div&gt;&lt;/p&gt;</p>\n</div>\n",
        "text": "</div></p>"
      }
    }
  ]
}
