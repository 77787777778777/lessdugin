      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mover><mover accent=\"true\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>⏞</mo></mover><mi>n</mi></mover></math></p>\n</div>\n",
        "math_errors": 0
      }
