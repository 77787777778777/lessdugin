      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mover accent=\"true\"><mi>x</mi><mo stretchy=\"false\">ˆ</mo></mover><mover accent=\"true\"><mi>y</mi><mo stretchy=\"false\">¯</mo></mover><mover accent=\"true\"><mi>v</mi><mo stretchy=\"false\">\u20d7</mo></mover><mover accent=\"true\"><mi>a</mi><mo>˙</mo></mover><mover accent=\"true\"><mi>n</mi><mo stretchy=\"false\">˜</mo></mover></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "operators",
      "input": {
        "tex": "\\sin x \\log y \\lim_{n\\to\\infty} a_n \\operatorname{rank} A",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mrow><mrow><mspace></mspace><mi>sin</mi></mrow><mo lspace=\"0.1667em\">\u2061</mo><mi>x</mi></mrow><mspace width=\"0.1667em\"></mspace><mrow><mrow><mspace></mspace><mi>log</mi></mrow><mo lspace=\"0.1667em\">\u2061</mo><mi>y</mi></mrow><mspace width=\"0.1667em\"></mspace><mrow><msub><mrow><mspace></mspace><mi>lim</mi></mrow><mrow><mi>n</mi><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">→</mo><mi>∞</mi></mrow></msub><mo lspace=\"0.1667em\">\u2061</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mspace width=\"0.1667em\"></mspace><mrow><mrow><mspace></mspace><mi>rank</mi></mrow><mo lspace=\"0.1667em\">\u2061</mo><mi>A</mi></mrow></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "delimiters",
      "input": {
        "tex": "\\left( \\frac{1}{2} \\right] \\big( x \\Big)",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo rspace=\"0.1667em\">]</mo></mrow><mo maxsize=\"1.2em\" minsize=\"1.2em\">(</mo><mi>x</mi><mo maxsize=\"1.623em\" minsize=\"1.623em\">)</mo></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "fonts",
      "input": {
        "tex": "\\mathbb{R} \\mathcal{F} \\mathfrak{g} \\mathbf{v} \\mathrm{d}",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mi>ℝ</mi><mrow><mspace></mspace><mi>ℱ\ufe00</mi></mrow><mi>𝔤</mi><mi>𝐯</mi><mrow><mspace></mspace><mi mathvariant=\"normal\">d</mi></mrow></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "text",
      "input": {
        "tex": "\\text{if } x > 0",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mtext>if&nbsp;</mtext><mi>x</mi><mo>&gt;</mo><mn>0</mn></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "binom",
      "input": {
        "tex": "\\binom{n}{k}",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mrow><mo>(</mo><mfrac linethickness=\"0\"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "overbrace",
      "input": {
