{
  "behaviour": "lfm/1",
  "kind": "mathml",
  "description": "Engine-specific MathML snapshots (math-core 0.9, filtered by sec. 7.3). input: {tex, display}; expected: html (the document HTML of $tex$ or $$tex$$) and math_errors. Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "frac",
      "input": {
        "tex": "\\frac{a}{b}",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mfrac><mi>a</mi><mi>b</mi></mfrac></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "sqrt-root",
      "input": {
        "tex": "\\sqrt{x} + \\sqrt[3]{y}",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><msqrt><mi>x</mi></msqrt><mo>+</mo><mroot><mi>y</mi><mn>3</mn></mroot></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "scripts",
      "input": {
        "tex": "x_i^2 + \\sum_{k=0}^{n} k",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup><mo>+</mo><munderover><mo lspace=\"0\">∑</mo><mrow><mi>k</mi><mo lspace=\"0\" rspace=\"0\">=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mi>k</mi></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "integral-display",
      "input": {
        "tex": "\\int_0^\\infty e^{-x}\\,dx",
        "display": true
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math display=\"block\"><msubsup><mo lspace=\"0\">∫</mo><mn>0</mn><mi>∞</mi></msubsup><msup><mi>e</mi><mrow><mo lspace=\"0\" rspace=\"0\">−</mo><mi>x</mi></mrow></msup><mspace width=\"0.16666667em\"></mspace><mi>d</mi><mi>x</mi></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "greek-and-symbols",
      "input": {
        "tex": "\\alpha\\beta\\Gamma \\le \\ne \\infty",
        "display": false
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math><mi>α</mi><mi>β</mi><mrow><mspace></mspace><mi mathvariant=\"normal\">Γ</mi></mrow><mo rspace=\"0\">≤</mo><mo lspace=\"0\">≠</mo><mi>∞</mi></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "matrix",
      "input": {
        "tex": "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}",
        "display": true
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math display=\"block\"><mrow><mo>(</mo><mtable displaystyle=\"false\" scriptlevel=\"0\"><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mi>d</mi></mtd></mtr></mtable><mo>)</mo></mrow></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "cases",
      "input": {
        "tex": "f(x)=\\begin{cases} 0 & x<0 \\\\ 1 & x \\ge 0 \\end{cases}",
        "display": true
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math display=\"block\"><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mrow><mo>{</mo><mtable displaystyle=\"false\" scriptlevel=\"0\"><mtr><mtd><mn>0</mn></mtd><mtd><mi>x</mi><mo>&lt;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mi>x</mi><mo>≥</mo><mn>0</mn></mtd></mtr></mtable><mo>\u2063</mo></mrow></math></p>\n</div>\n",
        "math_errors": 0
      }
    },
    {
      "name": "aligned",
      "input": {
        "tex": "\\begin{aligned} a &= b \\\\ c &= d \\end{aligned}",
        "display": true
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\"><math display=\"block\"><mtable displaystyle=\"true\" scriptlevel=\"0\"><mtr><mtd><mi>a</mi></mtd><mtd><mo>=</mo><mi>b</mi></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mo>=</mo><mi>d</mi></mtd></mtr></mtable></math></p>\n</div>\n",
        "math_errors": 0
