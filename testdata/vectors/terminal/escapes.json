{
  "behaviour": "lfm/1",
  "kind": "terminal",
  "description": "Terminal escape corpus (docs/spec/lfm-1.md sec. 9). input as for render plus print: {color, hyperlinks, reveal_spoilers, width} options of the plain-stdout printer; expected: styled (StyledDoc JSON) and printed (printer output). Invariants: no TermText contains C0, C1, DEL, U+2028/9 or bidi controls; printer output contains no escape sequence other than the allowed SGR and OSC 8 forms. Inputs generated by lfm1/gen_inputs.py; expected values blessed with LESSDUGIN_BLESS=1 and reviewed.",
  "vectors": [
    {
      "name": "csi-in-text",
      "input": {
        "text": "a \u001b[31mred\u001b[0m b",
        "print": {
          "color": false,
          "hyperlinks": false
        }
      },
      "expected": {
        "styled": {
          "blocks": [
            {
              "kind": {
                "para": [
                  [
                    {
                      "text": [
                        {
                          "plain": "a "
                        },
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "[31mred"
                        },
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "[0m b"
                        }
                      ]
                    }
                  ]
                ]
              }
            }
          ]
        },
        "printed": "a ^[[31mred^[[0m b\n"
      }
    },
    {
      "name": "osc-title-in-text",
      "input": {
        "text": "\u001b]0;pwned\u0007 x",
        "print": {
          "color": false,
          "hyperlinks": false
        }
      },
      "expected": {
        "styled": {
          "blocks": [
            {
              "kind": {
                "para": [
                  [
                    {
                      "text": [
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "]0;pwned"
                        },
                        {
                          "escaped": "^G"
                        },
                        {
                          "plain": " x"
                        }
                      ]
                    }
                  ]
                ]
              }
            }
          ]
        },
        "printed": "^[]0;pwned^G x\n"
      }
    },
    {
      "name": "osc8-in-text",
      "input": {
        "text": "\u001b]8;;https://evil.com\u001b\\click\u001b]8;;\u001b\\",
        "print": {
          "color": false,
          "hyperlinks": false
        }
      },
      "expected": {
        "styled": {
          "blocks": [
            {
              "kind": {
                "para": [
                  [
                    {
                      "text": [
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "]8;;https://evil.com"
                        },
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "\\click"
                        },
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "]8;;"
                        },
                        {
                          "escaped": "^["
                        },
                        {
                          "plain": "\\"
                        }
                      ]
                    }
                  ]
                ]
              }
            }
          ]
        },
        "printed": "^[]8;;https://evil.com^[\\click^[]8;;^[\\\n"
      }
    },
    {
      "name": "c1-csi",
      "input": {
        "text": "a\u009b31mb \u009d0;x\u009c",
        "print": {
          "color": false,
          "hyperlinks": false
        }
      },
      "expected": {
        "styled": {
          "blocks": [
            {
              "kind": {
                "para": [
                  [
                    {
                      "text": [
                        {
                          "plain": "a"
                        },
                        {
                          "escaped": "\\u{9b}"
                        },
                        {
                          "plain": "31mb "
                        },
                        {
                          "escaped": "\\u{9d}"
                        },
                        {
                          "plain": "0;x"
                        },
                        {
                          "escaped": "\\u{9c}"
                        }
                      ]
                    }
                  ]
                ]
              }
            }
          ]
        },
        "printed": "a\\u{9b}31mb \\u{9d}0;x\\u{9c}\n"
      }
    },
    {
      "name": "bell-backspace",
