                          "plain": "a"
                        },
                        {
                          "escaped": "⟨RLO⟩"
                        },
                        {
                          "plain": "b"
                        }
                      ],
                      "style": [
                        "CODE"
                      ]
                    },
                    {
                      "text": " and"
                    }
                  ]
                ]
              }
            },
            {
              "kind": {
                "code": {
                  "lang": null,
                  "lines": [
                    [
                      {
                        "plain": "if x"
                      },
                      {
                        "escaped": "⟨RLI⟩"
                      },
                      {
                        "plain": " then"
                      },
                      {
                        "escaped": "⟨PDI⟩"
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "printed": "a⟨RLO⟩b and\n\nif x⟨RLI⟩ then⟨PDI⟩\n"
      }
    },
