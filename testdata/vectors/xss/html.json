        "text": "<script>alert(1)</script>"
      },
      "expected": {
        "html": "<div class=\"lfm\" dir=\"auto\">\n<p dir=\"auto\">&lt;script&gt;alert(1)&lt;/script&gt;</p>\n</div>\n"
      }
    },
